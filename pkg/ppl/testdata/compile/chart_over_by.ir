Sort(service NULLS FIRST, status NULLS FIRST)
└─ Aggregate(`avg(latency)` = avg(latency) BY service, status)
   └─ Compute(status = CASE WHEN (status) IN (subquery) THEN status ELSE "OTHER" END)
      ├─ subquery (status) IN (subquery)
      │  └─ Project(status)
      │     └─ TopN(10, __rank DESC NULLS LAST, status NULLS FIRST)
      │        └─ Aggregate(__rank = sum(`avg(latency)`) BY status)
      │           └─ Aggregate(`avg(latency)` = avg(latency) BY service, status)
      │              └─ Compute(status = coalesce(CAST(status AS string), "NULL"))
      │                 └─ Filter(NOT is_null(service))
      │                    └─ Scan(logs)
      └─ Compute(status = coalesce(CAST(status AS string), "NULL"))
         └─ Filter(NOT is_null(service))
            └─ Scan(logs)
