Sort(_time NULLS FIRST, host NULLS FIRST)
└─ Aggregate(`count()` = count() BY _time = time_bucket(_time, 1, "h"), host)
   └─ Compute(host = CASE WHEN (host) IN (subquery) THEN host ELSE "OTHER" END)
      ├─ subquery (host) IN (subquery)
      │  └─ Project(host)
      │     └─ TopN(5, __rank DESC NULLS LAST, host NULLS FIRST)
      │        └─ Aggregate(__rank = sum(`count()`) BY host)
      │           └─ Aggregate(`count()` = count() BY _time = time_bucket(_time, 1, "h"), host)
      │              └─ Compute(host = coalesce(CAST(host AS string), "NULL"))
      │                 └─ Scan(logs)
      └─ Compute(host = coalesce(CAST(host AS string), "NULL"))
         └─ Scan(logs)
