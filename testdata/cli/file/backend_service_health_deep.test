# file: backend_server.log
# format: json
source=main
| stats count() as events, avg(duration_ms) as avg_dur, max(duration_ms) as max_dur, count(eval(status >= 500)) as errors by service
| eval error_rate = round(errors * 100.0 / events, 1)
| eval health = if(errors > 0, "unhealthy", "healthy")
| sort - errors, service
